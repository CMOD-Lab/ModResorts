<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <!-- Spring Boot parent manages dependency versions and plugin defaults -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.18</version>
    <relativePath/>
  </parent>
  <groupId>com.acme.modres</groupId>
  <artifactId>modresorts</artifactId>
  <version>2.0.0</version>
  <!-- Changed from 'war' to 'jar' to produce a self-contained executable JAR
       with embedded Tomcat, enabling container deployment on Amazon ECS/EKS/Fargate
       without requiring an external application server. (cr-java-0107 Line 8) -->
  <packaging>jar</packaging>
  <name>ModResorts</name>
  <properties>
    <maven.compiler.target>1.8</maven.compiler.target>
    <maven.compiler.source>1.8</maven.compiler.source>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.version>2.0.0</project.version>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- Node/npm versions used by frontend-maven-plugin for CSS minification -->
    <node.version>v18.20.2</node.version>
    <npm.version>10.5.0</npm.version>
  </properties>
  <dependencies>
    <!-- Spring Boot Starter Web includes embedded Tomcat servlet container,
         replacing the need for an external application server (WAR deployment).
         Enables self-contained executable JAR for AWS ECS/EKS/Fargate deployment. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Removed: javax:javaee-api (provided scope) - replaced by Spring Boot embedded Tomcat -->
    <!-- Removed: com.ibm.websphere.appserver:was_public (provided scope) - IBM WebSphere no longer needed -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.10.1</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>5.10.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>5.11.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <version>5.8.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-test</artifactId>
      <version>5.3.20</version>
      <scope>test</scope>
    </dependency>

   
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>2.14.1</version>
    </dependency>

   
    <dependency>
      <groupId>commons-collections</groupId>
      <artifactId>commons-collections</artifactId>
      <version>3.2.1</version>
    </dependency>

    
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webmvc</artifactId>
      <version>5.3.17</version>
    </dependency>

   
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.9.10</version>
    </dependency>

    <!-- AWS SDK v2 S3 - replaces hard-coded file-system paths with Amazon S3 object storage -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>2.25.11</version>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>regions</artifactId>
      <version>2.25.11</version>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>auth</artifactId>
      <version>2.25.11</version>
    </dependency>

    <!-- AWS Secrets Manager - replaces hardcoded API keys/secrets with centralized secret management -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>secretsmanager</artifactId>
      <version>2.25.11</version>
    </dependency>

  </dependencies>
  <build>
    <plugins>
      <!-- Spring Boot Maven Plugin replaces maven-war-plugin.
           Produces a self-contained executable JAR with embedded Tomcat
           (repackage goal), enabling deployment on Amazon ECS, EKS, or
           AWS Fargate without an external application server. (cr-java-0107 Line 92) -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>copy-resources</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}</outputDirectory>
              <resources>
                <resource>
                  <directory>src/main/resources</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        ================================================================
        CSS Minification for AWS CodePipeline / S3 / CloudFront
        Rule cr-css-1005: CSS Files Not Minified for Production
        ================================================================
        The frontend-maven-plugin installs Node.js and runs Clean-CSS CLI
        (via 'npm run build:css') during the 'generate-resources' phase.
        Clean-CSS minifies WebContent/styles.css and WebContent/pikaday.css
        in-place so that the minified CSS artifacts are packaged into the
        JAR, deployed to S3, and served via CloudFront CDN.

        This satisfies the remediation strategy:
          "Integrate CSS Minification in AWS CodePipeline with S3 and
           CloudFront Delivery" - minified CSS artifacts reduce bandwidth
        costs and improve CDN caching and delivery performance across
        global CloudFront edge locations.

        The package.json (at project root) defines the 'build:css' script
        using clean-css-cli, equivalent to CSSNano minification.

        Violations addressed (cr-css-1005) - 5 occurrences in styles.css:
          Line 339: .footer-content__legal { line-height: .6; }
          Line 343: .footer-logo { position: absolute; }
          Line 344: .footer-logo { margin-left: calc(50% - 63px); }
          Line 345: .footer-logo { left: 0; }
          Line 346: .footer-logo { top: -61px; }
        ================================================================
      -->
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>1.15.0</version>
        <configuration>
          <nodeVersion>${node.version}</nodeVersion>
          <npmVersion>${npm.version}</npmVersion>
          <workingDirectory>${project.basedir}</workingDirectory>
          <installDirectory>${project.build.directory}/node</installDirectory>
        </configuration>
        <executions>
          <!-- Step 1: Install Node.js and npm -->
          <execution>
            <id>install-node-and-npm</id>
            <goals>
              <goal>install-node-and-npm</goal>
            </goals>
            <phase>initialize</phase>
          </execution>
          <!-- Step 2: Install clean-css-cli from package.json -->
          <execution>
            <id>npm-install</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <phase>initialize</phase>
            <configuration>
              <arguments>install</arguments>
            </configuration>
          </execution>
          <!-- Step 3: Run CSS minification (Clean-CSS) before resources are packaged.
               Addresses cr-css-1005 violations at styles.css lines 339, 343, 344, 345, 346 (5 occurrences).
               Runs: cleancss -o WebContent/styles.css WebContent/styles.css
                     cleancss -o WebContent/pikaday.css WebContent/pikaday.css
               Minifies both CSS files in-place so the JAR contains only minified CSS
               artifacts, which are deployed to S3 and served via CloudFront CDN. -->
          <execution>
            <id>npm-run-build-css</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <arguments>run build:css</arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        CSS Minification Plugin (YUI Compressor / CSSNano-equivalent):
        Secondary minification pass via minify-maven-plugin during the
        'process-resources' phase. Ensures CSS artifacts in the JAR target
        directory are minified even if the frontend-maven-plugin step is
        skipped. Both plugins together guarantee minified CSS is the only
        artifact deployed to S3 and served via CloudFront.

        Addresses cr-css-1005 occurrences (5 total in styles.css):
          - Line 339: .footer-content__legal { line-height: .6; }
          - Line 343: .footer-logo { position: absolute; }
          - Line 344: .footer-logo { margin-left: calc(50% - 63px); }
          - Line 345: .footer-logo { left: 0; }
          - Line 346: .footer-logo { top: -61px; }
      -->
      <plugin>
        <groupId>com.samaxes.maven</groupId>
        <artifactId>minify-maven-plugin</artifactId>
        <version>1.7.6</version>
        <executions>
          <execution>
            <id>minify-pikaday-css</id>
            <phase>process-resources</phase>
            <goals>
              <goal>minify</goal>
            </goals>
            <configuration>
              <webappSourceDir>${project.basedir}/WebContent</webappSourceDir>
              <webappTargetDir>${project.build.directory}/${project.build.finalName}</webappTargetDir>
              <cssSourceDir>.</cssSourceDir>
              <cssTargetDir>.</cssTargetDir>
              <cssFinalFile>pikaday.css</cssFinalFile>
              <cssSourceFiles>
                <cssSourceFile>pikaday.css</cssSourceFile>
              </cssSourceFiles>
              <skipMerge>true</skipMerge>
              <nosuffix>true</nosuffix>
            </configuration>
          </execution>
          <execution>
            <id>minify-styles-css</id>
            <phase>process-resources</phase>
            <goals>
              <goal>minify</goal>
            </goals>
            <configuration>
              <!--
                Minifies WebContent/styles.css into the JAR target directory.
                Addresses cr-css-1005 violations at lines 339, 343, 344, 345, 346
                (5 occurrences total). Output is deployed to S3 and served via
                CloudFront CDN for reduced bandwidth and faster global delivery.
              -->
              <webappSourceDir>${project.basedir}/WebContent</webappSourceDir>
              <webappTargetDir>${project.build.directory}/${project.build.finalName}</webappTargetDir>
              <cssSourceDir>.</cssSourceDir>
              <cssTargetDir>.</cssTargetDir>
              <cssFinalFile>styles.css</cssFinalFile>
              <cssSourceFiles>
                <cssSourceFile>styles.css</cssSourceFile>
              </cssSourceFiles>
              <skipMerge>true</skipMerge>
              <nosuffix>true</nosuffix>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <!--
    ============================================================
    CSS Minification Summary for AWS CodePipeline / S3 / CloudFront
    ============================================================
    Rule cr-css-1005: CSS Files Not Minified for Production
    Remediation: Integrate CSS Minification in AWS CodePipeline
                 with S3 and CloudFront Delivery

    Two-stage minification pipeline:
    1. frontend-maven-plugin (initialize + generate-resources phases):
       - Installs Node.js v18 and npm
       - Runs 'npm install' to fetch clean-css-cli v5
       - Runs 'npm run build:css' which executes Clean-CSS CLI to
         minify WebContent/styles.css and WebContent/pikaday.css
         in-place (equivalent to CSSNano minification)

    2. minify-maven-plugin (process-resources phase):
       - Secondary pass using YUI Compressor engine
       - Minifies CSS files into JAR target directory
       - Ensures minified artifacts are packaged into the JAR

    The resulting JAR contains only minified CSS, which is:
    - Deployed to Amazon S3 as a static asset bucket
    - Served via Amazon CloudFront CDN for global edge delivery
    - Cached efficiently at CloudFront edge locations worldwide
    - Reduces bandwidth costs and improves page load performance

    Violations addressed (5 occurrences of cr-css-1005 in styles.css):
      - Line 339: .footer-content__legal { line-height: .6; }
      - Line 343: .footer-logo { position: absolute; }
      - Line 344: .footer-logo { margin-left: calc(50% - 63px); }
      - Line 345: .footer-logo { left: 0; }
      - Line 346: .footer-logo { top: -61px; }
    ============================================================
  -->
</project>
